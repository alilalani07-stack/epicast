# ──────────────────────────────────────────────────────────────
# EpiCast frontend environment
# Copy this file to `.env` and fill in real values.
# ──────────────────────────────────────────────────────────────

# Backend REST API base URL.
VITE_API_BASE_URL=http://localhost:8000

# When `true`, the frontend will NOT fall back to local mock data
# on API failure (recommended for production).
VITE_API_STRICT=false

# ── Firebase Authentication ───────────────────────────────────
# Required for real auth. Without these the app runs in demo mode.
# Get them from: Firebase Console → Project settings → Your apps → Web SDK config.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
