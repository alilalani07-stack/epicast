# Deployment Environment: "development" or "production"
ENV=development

# Frontend URL for CORS configuration
FRONTEND_URL=https://epicast.vercel.app

# Firebase Authentication Configuration
# In production, this must point to the absolute path of your Firebase service account JSON key file.
GOOGLE_APPLICATION_CREDENTIALS=/path/to/firebase-adminsdk.json

# If set to true, allows bypassing Firebase token verification (only works when ENV != production)
SKIP_AUTH=false
